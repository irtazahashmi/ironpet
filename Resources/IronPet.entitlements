<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime, which notarization requires, blocks these two unless they are declared. -->
	<!-- Voice notes and meeting audio. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Jumping to the iTerm tab where an agent waits, and finding a workspace. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
